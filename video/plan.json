 "clips": [
  {
   "key": "s01_0",
   "shot": "s01",
   "start": 0.35,
   "end": 4.702,
   "text": "A proposer posts a two hundred fifty dollar bond to say who won."
  },
  {
   "key": "s01_1",
   "shot": "s01",
   "start": 5.022,
   "end": 8.222,
   "text": "If it is wrong and nobody disputes it, it stands."
  },
  {
   "key": "s02_0",
   "shot": "s02",
   "start": 9.283,
   "end": 12.867,
   "text": "Gainsay checks the resolution before the bond goes up."
  },
  {
   "key": "s02_1",
   "shot": "s02",
   "start": 13.187,
   "end": 16.92,
   "text": "Evidence is bought with test U S D C on Sepolia."
  },
  {
   "key": "s03_0",
   "shot": "s03",
   "start": 17.983,
   "end": 22.314,
   "text": "It reads the proposal and buys the final score through Telegraph."
  },
  {
   "key": "s03_1",
   "shot": "s03",
   "start": 22.634,
   "end": 25.066,
   "text": "Holds. Flames two, Avalanche five."
  },
  {
   "key": "s03_2",
   "shot": "s03",
   "start": 28.034,
   "end": 32.151,
   "text": "Every answer carries a receipt, and one source is flagged as one."
  },
  {
   "key": "s03_3",
   "shot": "s03",
   "start": 32.471,
   "end": 35.842,
   "text": "Run on the first of November, after the window closed."
  },
  {
   "key": "s04_0",
   "shot": "s04",
   "start": 36.917,
   "end": 42.634,
   "text": "A second sport: Timberwolves one seventeen, Rockets one oh seven. The over holds."
  },
  {
   "key": "s05_0",
   "shot": "s05",
   "start": 44.117,
   "end": 46.634,
   "text": "It rejects answers about the wrong game."
  },
  {
   "key": "s05_1",
   "shot": "s05",
   "start": 47.717,
   "end": 53.498,
   "text": "Our first paid answers were about other games. Verified means unaltered, not correct."
  },
  {
   "key": "s06a_0",
   "shot": "s06a",
   "start": 56.117,
   "end": 59.061,
   "text": "Game not started: too early, nothing bought."
  },
  {
   "key": "s06b_0",
   "shot": "s06b",
   "start": 63.317,
   "end": 66.389,
   "text": "Not covered: it refuses, and buys nothing."
  },
  {
   "key": "s07_0",
   "shot": "s07",
   "start": 70.517,
   "end": 73.696,
   "text": "Six verdicts. Wrong has only happened in tests."
  },
  {
   "key": "s08_0",
   "shot": "s08",
   "start": 75.317,
   "end": 79.818,
   "text": "Watch lists every proposal in its challenge window, read from Polygon."
  },
  {
   "key": "s09_0",
   "shot": "s09",
   "start": 85.467,
   "end": 89.286,
   "text": "Read, buy, reject the wrong game, settle by arithmetic."
  },
  {
   "key": "s10_0",
   "shot": "s10",
   "start": 92.117,
   "end": 97.92,
   "text": "An outside developer added N F L and Champions League, through another team's miner."
  },
  {
   "key": "sol_0",
   "shot": "sol",
   "start": 101.717,
   "end": 106.517,
   "text": "On Solana, the venue's recorded result is treated as the proposal."
  },
  {
   "key": "sol_1",
   "shot": "sol",
   "start": 106.837,
   "end": 112.725,
   "text": "Gainsay buys the official score through Telegraph, and reads the on-chain result account."
  },
  {
   "key": "sol_2",
   "shot": "sol",
   "start": 113.045,
   "end": 114.709,
   "text": "It matches the A P I."
  },
  {
   "key": "sol_3",
   "shot": "sol",
   "start": 115.029,
   "end": 121.109,
   "text": "Fifteen Polymarket games: fourteen hold, one has no independent source, none wrong."
  },
  {
   "key": "s12_0",
   "shot": "s12",
   "start": 122.283,
   "end": 126.72,
   "text": "Gainsay is live, on testnet. No proposer has used it yet."
